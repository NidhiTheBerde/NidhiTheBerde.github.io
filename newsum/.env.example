# LLM Provider: "claude" or "ollama"
LLM_PROVIDER=claude

# Claude (if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-...

# Ollama (if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Gmail OAuth (path to your credentials JSON from Google Cloud Console)
GMAIL_CREDENTIALS_PATH=~/.credentials/gmail_credentials.json

# Optional: email the digest to yourself
SEND_EMAIL_DIGEST=false
SELF_EMAIL=you@gmail.com
SMTP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Pipeline settings
LOG_LEVEL=INFO
DB_PATH=./pipeline.db
